{
  "compilerOptions": {
    // Estrutura de arquivos
    "rootDir": "./src",        // Onde ficam os arquivos .ts
    "outDir": "./dist",        // Onde vão os compilados .js

    // Configuração de módulos (CommonJS = mais simples)
    "module": "commonjs",
    "target": "ES2020",

    // Tipos e bibliotecas
    "types": ["node"],
    "lib": ["ES2020"],

    // Saídas adicionais
    "sourceMap": true,         // Mapas para debug
    "declaration": true,       // Gerar arquivos .d.ts
    "declarationMap": true,

    // Checagem estrita
    "strict": true,
    "esModuleInterop": true,   // Permite import default de libs CommonJS
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
